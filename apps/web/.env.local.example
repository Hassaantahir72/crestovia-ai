# Public project URL and publishable key. These are intended for browser use.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional compatibility fallback for older Supabase projects only.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_LEGACY_ANON_KEY

# Server-only AI provider secret. Never prefix with NEXT_PUBLIC_ and never commit a real key.
GROQ_API_KEY=configure_privately_when_ready
GROQ_MODEL=llama-3.3-70b-versatile

# Server-only admin key for owner invitations. Never expose or commit a real key.
SUPABASE_SERVICE_ROLE_KEY=configure_privately_when_needed

# Email MFA signing and OTP hashing secret: random value at least 32 characters.
APP_MFA_SECRET=generate_and_configure_privately
# Resend API key and verified sender are required to send owner email codes.
RESEND_API_KEY=configure_privately_when_ready
RESEND_FROM_EMAIL=verified-sender@yourdomain.com

# Optional WhatsApp Cloud API -> n8n ingress. Keep all values private; never use NEXT_PUBLIC_.
WHATSAPP_APP_SECRET=configure_privately_when_ready
WHATSAPP_VERIFY_TOKEN=configure_privately_when_ready
N8N_WHATSAPP_WEBHOOK_URL=https://YOUR_TRUSTED_N8N_HOST/webhook/REPLACE_ME
N8N_WEBHOOK_SECRET=configure_privately_when_ready
