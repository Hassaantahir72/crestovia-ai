# Reference only. Actual values belong in apps/web/.env.local and apps/api/.env.
# Never place Supabase secret/service-role keys in frontend environment variables.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# Optional WhatsApp Cloud API -> n8n ingress. Keep all values private; never use NEXT_PUBLIC_.
WHATSAPP_APP_SECRET=configure_privately_when_ready
WHATSAPP_VERIFY_TOKEN=configure_privately_when_ready
N8N_WHATSAPP_WEBHOOK_URL=https://YOUR_TRUSTED_N8N_HOST/webhook/REPLACE_ME
N8N_WEBHOOK_SECRET=configure_privately_when_ready
